// MAYA_X_2.0 — Prisma schema
//
// M1B added the Identity & Access core data models — Admin and User. M3
// completes that domain with the auth tables the Database Design document
// always specified alongside them: Role/AdminUserRole (admin RBAC),
// UserCredential (customer password + lockout state, deliberately a
// separate table from User per the design doc), and RefreshToken
// (polymorphic — belongs to exactly one of User or Admin, enforced by a
// CHECK constraint in the migration SQL since Prisma's schema DSL can't
// express that directly). See docs/04-database for full rationale.
//
// Supabase connection strings (per Prisma's documented Supabase guidance):
//   DATABASE_URL — the PgBouncer-pooled connection (port 6543,
//                  ?pgbouncer=true&connection_limit=1). Used by the app at
//                  runtime; safe under serverless/many-short-lived-connections.
//   DIRECT_URL   — the direct, non-pooled connection (port 5432). Used only
//                  for `prisma migrate` — PgBouncer's transaction pooling
//                  mode does not support the session-level features
//                  migrations rely on.
// In plain local/Docker Postgres (no pooler), both variables simply point
// to the same connection string — see .env.example.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, citext]
}

/// Agency staff accounts (Database Design §3.1 `admin_users`). `passwordHash`
/// is verified by AuthService as of M3 (argon2id); RBAC is expressed via
/// the adminUserRoles join to Role.
model Admin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.Citext
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  adminUserRoles       AdminUserRole[]
  refreshTokens        RefreshToken[]
  bookingStatusChanges BookingStatusHistory[]
  membershipPlans      MembershipPlan[]

  @@map("admin_users")
}

/// Registered customer accounts (Database Design §3.1 `users`). Credentials
/// live in the separate UserCredential table (a customer may exist without
/// one — e.g. created via the admin-facing Users CRUD — until they register
/// through /auth/register and gain the ability to log in).
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  fullName        String    @map("full_name")
  phone           String?
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  credential      UserCredential?
  refreshTokens   RefreshToken[]
  bookingRequests BookingRequest[]
  subscriptions   Subscription[]
  payments        Payment[]

  @@map("users")
}

/// Named admin roles (Database Design §3.1 `roles`) — e.g. "admin",
/// "super_admin". Fine-grained permissions per role are out of scope for
/// M3; RolesGuard checks role name membership only.
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique
  description String?

  adminUserRoles AdminUserRole[]

  @@map("roles")
}

/// Many-to-many join between Admin and Role (`admin_user_roles`).
model AdminUserRole {
  adminUserId String @map("admin_user_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid

  admin Admin @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

/// Customer password + lockout state (`user_credentials`), 1:1 with User.
/// Kept separate from User itself per the Database Design doc, so a
/// customer record can exist (e.g. admin-created) before it ever gains
/// login credentials.
model UserCredential {
  userId              String    @id @map("user_id") @db.Uuid
  passwordHash        String    @map("password_hash")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Refresh tokens (`refresh_tokens`) — belongs to exactly one of User or
/// Admin (never both, never neither); enforced by a CHECK constraint added
/// by hand in the migration SQL, since the Prisma schema DSL has no way to
/// express "exactly one of these two FKs is set." Only `tokenHash` (a
/// SHA-256 digest) is ever stored — the raw token exists only in the
/// client's cookie.
model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  adminUserId String?   @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminUserId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// M4 — Talent Catalog + Admin operations. Extends the Identity & Access
// domain above with the Talent Catalog entities the Database Design
// document specifies (TALENT_CATEGORIES, TALENTS, TALENT_CATEGORY_MAP,
// MEDIA_ASSETS) plus two entities the document doesn't cover — City and
// Location — added because the admin panel's talent form needs a
// controlled, filterable city/location taxonomy rather than free text.
//
// Two deliberate deviations from the ERD, both documented on the model
// they affect:
//   - Talent carries pricing fields (basePrice/hourlyRate/overnightRate/
//     weekendRate) directly rather than a separate pricing table — pricing
//     is always exactly 1:1 with a talent and never has its own lifecycle,
//     so a join table would add a query on every listing for no benefit.
//   - TalentMedia is a real, Talent-only foreign key rather than the ERD's
//     generic polymorphic MEDIA_ASSETS(owner_type, owner_id) — M4 only
//     needs media for Talent, and a polymorphic FK can't carry a real
//     database foreign-key constraint. If a later milestone needs media on
//     other entities too, that's the point to introduce the generic table.
// ---------------------------------------------------------------------------

enum TalentAvailability {
  available
  limited
  unavailable
}

enum TalentVerificationStatus {
  pending
  verified
  rejected
}

/// City Talent are based in and events are hosted in (docs/04-database has
/// no City entity — added for M4's admin-managed, filterable location
/// taxonomy rather than free-text city names).
model City {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  state        String
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  locations Location[]
  talents   Talent[]

  @@unique([name, state])
  @@map("cities")
}

/// Sub-area within a City (e.g. a neighborhood or venue district) — added
/// alongside City for the same reason.
model Location {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  cityId       String   @map("city_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  city    City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  talents Talent[]

  @@unique([cityId, name])
  @@map("locations")
}

/// Talent categories (docs/04-database `talent_categories`) — Event Host,
/// Anchor & MC, Brand Ambassador, Classical Dance, Folk & Live Music,
/// Photography, Modeling, Singing (the same taxonomy the M2 public-site
/// mock data used).
model TalentCategory {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String  @unique
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  talents       TalentCategoryMap[]
  subCategories TalentSubCategory[]

  @@map("talent_categories")
}

/// Many-to-many join between Talent and TalentCategory (`talent_category_map`).
model TalentCategoryMap {
  talentId   String @map("talent_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  talent   Talent         @relation(fields: [talentId], references: [id], onDelete: Cascade)
  category TalentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([talentId, categoryId])
  @@map("talent_category_map")
}

/// Sub-categories (`talent_subcategories`) — a finer-grained tag nested
/// under one parent TalentCategory (e.g. Category "Event Host" ->
/// Sub-categories "Wedding Host", "Corporate Host"), managed from its own
/// admin page the same way TalentCategory is.
model TalentSubCategory {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String  @map("category_id") @db.Uuid
  name         String
  slug         String  @unique
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  category TalentCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  talents  TalentSubCategoryMap[]

  @@map("talent_subcategories")
}

/// Many-to-many join between Talent and TalentSubCategory (`talent_subcategory_map`).
model TalentSubCategoryMap {
  talentId      String @map("talent_id") @db.Uuid
  subCategoryId String @map("subcategory_id") @db.Uuid

  talent      Talent            @relation(fields: [talentId], references: [id], onDelete: Cascade)
  subCategory TalentSubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([talentId, subCategoryId])
  @@map("talent_subcategory_map")
}

/// Talent profiles (docs/04-database `talents`), extended with the
/// operational fields the M4 admin panel manages: profile detail
/// (age/height/bodyType/languages), pricing, availability, and the
/// premium/featured/verification/active flags the dashboard and talent
/// listing filter on.
model Talent {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName String  @map("display_name")
  slug        String  @unique
  tagline     String?
  bio         String?

  age        Int?
  cityId     String   @map("city_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  languages  String[] @default([])
  heightCm   Int?     @map("height_cm")
  weightKg   Int?     @map("weight_kg")
  bodyType   String?  @map("body_type")

  // Outstation availability — a talent may be based in `cityId` but still
  // willing to travel to a shortlist of other cities for bookings.
  preferredCityIds String[] @default([]) @map("preferred_city_ids") @db.Uuid
  availableOutside Boolean  @default(false) @map("available_outside")

  // Casting-sheet attributes (fashion/modeling industry standard), shown on
  // the talent's public profile alongside the other Basic Details fields.
  // chest/waist/hip are the structured admin-form inputs; `measurements`
  // is the legacy single "34-28-35" string apps/web's public profile page
  // renders — kept in sync (auto-composed from chest/waist/hip) by
  // TalentService so the public site needed no changes for this split.
  nationality         String? @map("nationality")
  measurements        String? @map("measurements")
  chest               String? @map("chest")
  waist               String? @map("waist")
  hip                 String? @map("hip")
  dressSize           String? @map("dress_size")
  hairColour          String? @map("hair_colour")
  hairLength          String? @map("hair_length")
  eyeColour           String? @map("eye_colour")
  generalAvailability String? @map("general_availability")

  // Connections — direct contact channels for this talent, all optional.
  mobile         String? @map("mobile")
  mobile2        String? @map("mobile_2")
  whatsapp       String? @map("whatsapp")
  telegram       String? @map("telegram")
  otherContact   String? @map("other_contact")

  currency           String   @default("INR")
  basePrice          Decimal  @map("base_price") @db.Decimal(10, 2)
  hourlyRate         Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  overnightRate      Decimal? @map("overnight_rate") @db.Decimal(10, 2)
  weekendRate        Decimal? @map("weekend_rate") @db.Decimal(10, 2)
  customPricingNotes String?  @map("custom_pricing_notes")

  availability       TalentAvailability       @default(available)
  verificationStatus TalentVerificationStatus @default(pending) @map("verification_status")
  isPremium          Boolean                  @default(false) @map("is_premium")
  isFeatured         Boolean                  @default(false) @map("is_featured")
  isActive           Boolean                  @default(true) @map("is_active")
  displayOrder       Int                      @default(0) @map("display_order")

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  city            City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  location        Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  categories      TalentCategoryMap[]
  subCategories   TalentSubCategoryMap[]
  media           TalentMedia[]
  bookingRequests BookingRequest[]

  @@map("talents")
}

/// Join between Talent and the M6 Media Library (`talent_media`) — ordering
/// and primary-image selection are per-talent-usage concerns, so they live
/// here rather than on MediaAsset itself, which is fully reusable. Superseded
/// M4's URL-only version of this table (see the M6 migration for the
/// backfill: every pre-M6 row's `url`/`alt` became one legacy MediaAsset).
model TalentMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  talentId     String   @map("talent_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  talent     Talent     @relation(fields: [talentId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([talentId, mediaAssetId])
  @@index([talentId])
  @@index([mediaAssetId])
  @@map("talent_media")
}

// ---------------------------------------------------------------------------
// M5A — Booking (docs/04-database §3.3, Enterprise Architecture §7.1).
// Guest or Member submission, Agency review queue, and an append-only
// status-change audit trail. Payment, membership, coupons, and
// notifications are deliberately out of scope here (separate milestones);
// BookingRequest has no payment reference yet.
// ---------------------------------------------------------------------------

enum BookingStatus {
  submitted
  under_review
  contacted
  confirmed
  declined
  expired
  cancelled
}

/// Customer booking requests (`booking_requests`) — Guest (no account) or
/// Member (authenticated User). `userId` is nullable and guest_name/email
/// carry the contact details instead when there's no account; exactly one
/// of "has a userId" or "has guest_name + guest_email" must hold, enforced
/// by a CHECK constraint in the migration SQL (Prisma's schema DSL can't
/// express that directly) — see RefreshToken's `owner` constraint for the
/// same pattern.
model BookingRequest {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?       @map("user_id") @db.Uuid
  talentId     String        @map("talent_id") @db.Uuid
  guestName    String?       @map("guest_name")
  guestEmail   String?       @map("guest_email")
  guestPhone   String?       @map("guest_phone")
  status       BookingStatus @default(submitted)
  eventDate    DateTime?     @map("event_date") @db.Date
  eventDetails String?       @map("event_details")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  talent        Talent                 @relation(fields: [talentId], references: [id], onDelete: Restrict)
  statusHistory BookingStatusHistory[]

  @@index([talentId])
  @@index([userId])
  @@index([status])
  @@map("booking_requests")
}

/// Append-only audit trail of status transitions (`booking_status_history`)
/// — one row per admin-driven status change, per Enterprise Architecture
/// §7.1's state machine.
model BookingStatusHistory {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingRequestId String         @map("booking_request_id") @db.Uuid
  adminUserId      String?        @map("admin_user_id") @db.Uuid
  previousStatus   BookingStatus? @map("previous_status")
  newStatus        BookingStatus  @map("new_status")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  admin          Admin?         @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([bookingRequestId])
  @@map("booking_status_history")
}

// ---------------------------------------------------------------------------
// M5B — Membership & Payment (docs/04-database §3.4/§3.5, Enterprise
// Architecture §8). Membership plan browsing/purchase and Razorpay
// integration. Coupons are deliberately out of scope for this milestone
// (deferred, per the original plan's M7 "Coupons polish" grouping) — no
// coupon-related tables or columns are added here.
//
// One deliberate deviation from the ERD: `payments.booking_request_id`
// (documented there as a forward-looking column "so booking-linked payment
// can be enabled later without a schema migration") is omitted — no
// booking-linked payment feature exists yet, so a permanently-null column
// held "just in case" isn't added; that FK is this project's to add
// alongside whichever future milestone actually implements booking payment.
// `subscriptionId` below is therefore required, not nullable.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  pending_payment
  active
  expired
  cancelled
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

enum BillingCycle {
  one_time
  monthly
  annual
}

/// Subscribable plan definitions (`membership_plans`).
model MembershipPlan {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String       @unique
  price        Decimal      @db.Decimal(12, 2)
  currency     String       @default("INR") @db.Char(3)
  billingCycle BillingCycle @map("billing_cycle")
  benefits     Json         @default("[]")
  isActive     Boolean      @default(true) @map("is_active")
  createdBy    String?      @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  createdByAdmin Admin?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  subscriptions  Subscription[]

  @@map("membership_plans")
}

/// A user's membership instance (`subscriptions`). `priceAtPurchase`
/// deliberately duplicates the plan's price at purchase time — a
/// controlled denormalization so a later price change never rewrites a
/// customer's financial history.
model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  membershipPlanId String             @map("membership_plan_id") @db.Uuid
  status           SubscriptionStatus @default(pending_payment)
  priceAtPurchase  Decimal            @map("price_at_purchase") @db.Decimal(12, 2)
  startsAt         DateTime?          @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(6)
  cancelledAt      DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([userId])
  @@map("subscriptions")
}

/// Razorpay transaction records (`payments`). Every payment here is
/// subscription-linked (see the file-level note on why `bookingRequestId`
/// isn't included yet).
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  status            PaymentStatus @default(created)
  gatewayResponse   Json          @default("{}") @map("gateway_response")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// M6 — Media Library (docs/04-database's generic `media_assets` concept,
// finally introduced for real). Cloudinary-backed upload, storage, and
// reuse of images across the system. TalentMedia (M4) is migrated to
// reference MediaAsset instead of storing its own url/alt — see that
// model's comment and the M6 migration for the backfill strategy.
//
// MediaTag was listed as optional in the milestone brief and is deferred:
// MediaFolder already gives admins a organizational axis (folder filter),
// and no requirement called for tag-based filtering specifically. Adding
// it later is a purely additive migration (new table + join table), so
// deferring costs nothing. See DEPLOYMENT.md's M6 section for the note.
// ---------------------------------------------------------------------------

/// Folder organization for the Media Library (`media_folders`). Optional,
/// flat-or-nested via `parentId` self-relation; assets may sit in no folder.
model MediaFolder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("MediaFolderChildren")
  assets   MediaAsset[]

  @@map("media_folders")
}

/// The Media Library's core entity (`media_assets`) — one row per uploaded
/// (or, for pre-M6 data, legacy) image. `publicId`/`contentHash` are
/// nullable because rows backfilled from M4's URL-only TalentMedia were
/// never actually uploaded to Cloudinary and have neither; every asset
/// created through the M6 upload endpoint has both. `contentHash` (SHA-256
/// of the uploaded bytes) is how duplicate-upload detection works: the
/// upload endpoint checks for an existing row with the same hash before
/// calling Cloudinary at all.
model MediaAsset {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId         String? @map("folder_id") @db.Uuid
  publicId         String? @unique @map("public_id")
  url              String
  format           String?
  resourceType     String  @default("image") @map("resource_type")
  bytes            Int?
  width            Int?
  height           Int?
  contentHash      String? @unique @map("content_hash")
  originalFilename String? @map("original_filename")
  altText          String? @map("alt_text")
  displayOrder     Int     @default(0) @map("display_order")
  source           String  @default("cloudinary")

  // AI-ready metadata (M6 polish pass) -- nullable/empty-default, populated
  // by no code path today. Added now so a future AI-tagging/auto-alt-text/
  // moderation milestone is a pure backfill job, never a schema migration on
  // an asset table that may have grown very large by then.
  aiDescription   String?  @map("ai_description")
  aiTags          String[] @default([]) @map("ai_tags")
  dominantColor   String?  @map("dominant_color")
  detectedObjects Json?    @map("detected_objects")
  detectedFaces   Json?    @map("detected_faces")

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  folder      MediaFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  talentMedia TalentMedia[]
  usages      MediaUsage[]

  @@index([folderId])
  @@index([deletedAt])
  @@map("media_assets")
}

enum HeroMode {
  image
  video
  slider
}

/// Singleton row (application code always reads/writes the one fixed id —
/// see hero.service.ts's HERO_SETTINGS_ID) configuring the public site's
/// Hero background: a single image, a single autoplay/muted video, or an
/// ordered slider of images. `mediaIds` references MediaAsset by id (plain
/// text array, matching the array-column convention used elsewhere in this
/// schema, e.g. Talent.languages) — order matters only in "slider" mode.
model HeroSettings {
  id        String   @id @db.Uuid
  mode      HeroMode @default(image)
  mediaIds  String[] @default([]) @map("media_ids")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("hero_settings")
}

/// Tracks every place a MediaAsset is actually used (`media_usages`), so the
/// Media Library can show a "used in N places" count and the API can block
/// deletion of an in-use asset. `entityType`/`entityId` is a deliberate,
/// narrow polymorphic reference (unlike TalentMedia's real FK to Talent —
/// see that model's comment) because usage tracking spans arbitrary future
/// entity types and is advisory bookkeeping, not a relation the database
/// needs to enforce referential integrity on.
model MediaUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("media_usages")
}
