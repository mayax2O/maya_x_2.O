# --- Read by the app today (M0 + M1A) ---
NODE_ENV=development
PORT=4000

# Local/Docker Postgres (no connection pooler): both variables point to the
# same database. See infra/docker/docker-compose.yml for matching credentials.
DATABASE_URL=postgresql://maya_x:maya_x_dev_password@localhost:5432/maya_x
DIRECT_URL=postgresql://maya_x:maya_x_dev_password@localhost:5432/maya_x

# --- Supabase production reference (do not commit real values) ---
# Supabase gives you two connection strings — use both, they are not
# interchangeable:
#   DATABASE_URL — "Connection pooling" string from Supabase's Database
#                   Settings, port 6543, with ?pgbouncer=true appended.
#                   This is what the running app uses.
#   DIRECT_URL   — "Connection string" (direct), port 5432. Required by
#                   `prisma migrate`, which needs session-level features
#                   PgBouncer's transaction pooling mode doesn't support.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Reserved for later milestones (documented now for the ops/env story;
#     NOT yet read or validated by any code in this app) ---
# M1B — Identity & Access (auth)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
#
# M1/M3 — caching
# REDIS_URL=redis://localhost:6379
#
# M2 — Media Library
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
#
# — Transactional email
# RESEND_API_KEY=
#
# M5 — Payments
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
