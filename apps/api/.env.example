# --- Read by the app today (M0 + M1A) ---
NODE_ENV=development
PORT=4000

# --- Cloud Supabase Postgres (the only supported local-dev database — no
# Docker, no local Postgres install). Copy both connection strings from your
# Supabase project's Database Settings; they are not interchangeable:
#   DATABASE_URL — "Connection pooling" string, port 6543, with
#                   ?pgbouncer=true&connection_limit=1 appended. This is what
#                   the running app (`pnpm dev`) uses.
#   DIRECT_URL   — "Connection string" (direct), port 5432. Required by
#                   `prisma migrate`, which needs session-level features
#                   PgBouncer's transaction pooling mode doesn't support.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- CI only — do not use these locally ---
# GitHub Actions CI (.github/workflows/ci.yml) spins up an ephemeral
# postgres:16-alpine service container for tests; it is not part of the
# local dev workflow, which always talks directly to the cloud Supabase
# database above.

# --- M3: JWT authentication ---
# Two distinct, high-entropy secrets — never reuse one for both, and never
# commit real values. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret-for-access-tokens-only
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret-for-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- M3: CORS ---
# Comma-separated allow-list of origins permitted to call this API with
# credentials (cookies). Defaults (if unset) already cover local apps/web
# (:3000) and apps/admin (:3001) — override in production with the deployed
# Vercel URLs.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- M3: rate limiting (@nestjs/throttler) ---
# Defaults (if unset): 100 requests per 60-second window per IP, applied
# globally; auth endpoints (login/register) use a stricter override in code.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100

# --- M5B: Razorpay (Membership & Payment) ---
# From the Razorpay Dashboard (Settings -> API Keys for the key pair;
# Settings -> Webhooks for the webhook secret, once a webhook pointing at
# POST /api/v1/payments/webhook is configured there). Use Test Mode keys for
# local/staging — never commit real values.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

# --- Reserved for later milestones (documented now for the ops/env story;
#     NOT yet read or validated by any code in this app) ---
# M1/M3 — caching
# REDIS_URL=redis://localhost:6379
#
# M2 — Media Library
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
#
# — Transactional email
# RESEND_API_KEY=
