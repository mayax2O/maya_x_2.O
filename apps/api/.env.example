# --- Read by the app today (M0 + M1A) ---
NODE_ENV=development
PORT=4000

# --- Cloud Supabase Postgres (the only supported local-dev database — no
# Docker, no local Postgres install). Copy both connection strings from your
# Supabase project's Database Settings; they are not interchangeable:
#   DATABASE_URL — "Connection pooling" string, port 6543, with
#                   ?pgbouncer=true&connection_limit=1 appended. This is what
#                   the running app (`pnpm dev`) uses.
#   DIRECT_URL   — "Connection string" (direct), port 5432. Required by
#                   `prisma migrate`, which needs session-level features
#                   PgBouncer's transaction pooling mode doesn't support.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- CI only — do not use these locally ---
# GitHub Actions CI (.github/workflows/ci.yml) spins up an ephemeral
# postgres:16-alpine service container for tests; it is not part of the
# local dev workflow, which always talks directly to the cloud Supabase
# database above.

# --- Reserved for later milestones (documented now for the ops/env story;
#     NOT yet read or validated by any code in this app) ---
# M1B — Identity & Access (auth)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
#
# M1/M3 — caching
# REDIS_URL=redis://localhost:6379
#
# M2 — Media Library
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
#
# — Transactional email
# RESEND_API_KEY=
#
# M5 — Payments
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
